# Puerto HTTP del servidor
PORT=3000

# Ruta del fichero SQLite. Usa una ruta dentro de un volumen persistente en producción.
DATABASE_PATH=./data/geest.db

# URL externa a la que se notifica el archivado de una tarea (POST).
# Si se deja vacía, el envío se registra como fallido con el error NOTIFY_URL_NOT_CONFIGURED.
NOTIFY_URL=https://webhook.site/tu-uuid-aqui

# Reintentos de notificación: máximo de intentos y backoff exponencial (ms).
# Espera antes del intento n: NOTIFY_RETRY_BASE_MS * 2^(n-2)  ->  1s, 2s con los valores por defecto.
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_RETRY_BASE_MS=1000
NOTIFY_TIMEOUT_MS=5000

# Frecuencia con la que el worker de la outbox busca notificaciones pendientes (ms).
NOTIFY_POLL_INTERVAL_MS=1000

# Tiempo máximo que un request idempotente duplicado espera a que termine el original (ms).
IDEMPOTENCY_WAIT_MS=5000
